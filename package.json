{
  "name": "escolinha",
  "private": true,
  "description": "Atalhos para o front (frontend/) e para o banco (backend/).",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "setup": "npm --prefix frontend install",
    "db:start": "supabase --workdir backend start",
    "db:stop": "supabase --workdir backend stop",
    "db:reset": "supabase --workdir backend db reset",
    "db:push": "supabase --workdir backend db push",
    "db:diff": "supabase --workdir backend db diff"
  }
}
