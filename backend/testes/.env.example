# Opcional. Sem este arquivo, os testes leem frontend/.env — é o mesmo
# projeto e a mesma anon key, que é pública por natureza.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Contas de teste. São fixas de propósito: os testes fazem login nelas em
# vez de criar conta nova a cada rodada, para não encher o Authentication.
# Na primeira execução elas são criadas sozinhas.
TESTE_EMAIL=escolinha.teste.claude@gmail.com
TESTE_EMAIL_2=escolinha.teste2.claude@gmail.com
TESTE_SENHA=escolinha-teste-2026
